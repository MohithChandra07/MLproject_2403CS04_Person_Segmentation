<mxfile host="app.diagrams.net" modified="2026-11-17T09:00:00.000Z" agent="Python" version="24.0.0" type="device">
  <diagram id="diag_unet" name="1. U-Net Architecture">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#F8FAFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title1" value="&lt;b&gt;Binary Person Segmentation U-Net Architecture (Penn-Fudan Pedestrian)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B;&quot;&gt;4-Level Encoder-Decoder with Skip Connections | 7.76M Parameters | Resolution: 256×256&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="800" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="inp" value="&lt;b&gt;Input Image&lt;/b&gt;&lt;br&gt;256 × 256 × 3&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Normalized RGB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="enc1" value="&lt;b&gt;Encoder 1&lt;/b&gt;&lt;br&gt;DoubleConv(3→32)&lt;br&gt;&lt;b&gt;256 × 256 × 32&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="190" y="160" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="enc2" value="&lt;b&gt;Encoder 2&lt;/b&gt;&lt;br&gt;DoubleConv(32→64)&lt;br&gt;&lt;b&gt;128 × 128 × 64&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="310" y="260" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="enc3" value="&lt;b&gt;Encoder 3&lt;/b&gt;&lt;br&gt;DoubleConv(64→128)&lt;br&gt;&lt;b&gt;64 × 64 × 128&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="enc4" value="&lt;b&gt;Encoder 4&lt;/b&gt;&lt;br&gt;DoubleConv(128→256)&lt;br&gt;&lt;b&gt;32 × 32 × 256&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="550" y="460" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="bottle" value="&lt;b&gt;Bottleneck&lt;/b&gt;&lt;br&gt;DoubleConv(256→512)&lt;br&gt;&lt;b&gt;16 × 16 × 512&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="150" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="dec4" value="&lt;b&gt;Decoder 4&lt;/b&gt;&lt;br&gt;Concat + DoubleConv&lt;br&gt;&lt;b&gt;32 × 32 × 256&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="840" y="460" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dec3" value="&lt;b&gt;Decoder 3&lt;/b&gt;&lt;br&gt;Concat + DoubleConv&lt;br&gt;&lt;b&gt;64 × 64 × 128&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="960" y="360" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dec2" value="&lt;b&gt;Decoder 2&lt;/b&gt;&lt;br&gt;Concat + DoubleConv&lt;br&gt;&lt;b&gt;128 × 128 × 64&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="1080" y="260" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dec1" value="&lt;b&gt;Decoder 1&lt;/b&gt;&lt;br&gt;Concat + DoubleConv&lt;br&gt;&lt;b&gt;256 × 256 × 32&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="1200" y="160" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="outconv" value="&lt;b&gt;Final Conv 1×1&lt;/b&gt;&lt;br&gt;Conv2d(32→1)&lt;br&gt;&lt;b&gt;256 × 256 × 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#EAB308;strokeWidth=2;fontColor=#713F12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="160" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mask" value="&lt;b&gt;Binary Mask&lt;/b&gt;&lt;br&gt;Sigmoid(z) ≥ 0.5&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#15803D;&quot;&gt;0: Bg | 1: Person&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#16A34A;strokeWidth=2;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="1500" y="160" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" source="inp" target="enc1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_down1" value="MaxPool 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;fontColor=#DC2626;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc1" target="enc2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_down2" value="MaxPool 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;fontColor=#DC2626;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc2" target="enc3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_down3" value="MaxPool 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;fontColor=#DC2626;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc3" target="enc4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_down4" value="MaxPool 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;fontColor=#DC2626;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc4" target="bottle" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_up4" value="ConvTranspose 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#16A34A;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="bottle" target="dec4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_up3" value="ConvTranspose 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#16A34A;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="dec4" target="dec3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_up2" value="ConvTranspose 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#16A34A;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="dec3" target="dec2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_up1" value="ConvTranspose 2×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#16A34A;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="dec2" target="dec1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_skip1" value="Skip 1 (Copy &amp; Concat: 32)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=#9333EA;fontColor=#9333EA;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc1" target="dec1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_skip2" value="Skip 2 (Copy &amp; Concat: 64)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=#9333EA;fontColor=#9333EA;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc2" target="dec2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_skip3" value="Skip 3 (Copy &amp; Concat: 128)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=#9333EA;fontColor=#9333EA;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc3" target="dec3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_skip4" value="Skip 4 (Copy &amp; Concat: 256)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=#9333EA;fontColor=#9333EA;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" source="enc4" target="dec4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_dec1_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" source="dec1" target="outconv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_out_mask" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" source="outconv" target="mask" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="leg" value="&lt;b&gt;Legend &amp; Layer Specifications:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;DoubleConv:&lt;/b&gt; Conv2d(3×3, pad 1) → BatchNorm2d → ReLU → Conv2d(3×3, pad 1) → BatchNorm2d → ReLU&lt;br&gt;• &lt;b&gt;Downsampling:&lt;/b&gt; MaxPool2d(kernel=2, stride=2)&lt;br&gt;• &lt;b&gt;Upsampling:&lt;/b&gt; ConvTranspose2d(kernel=2, stride=2) (halves channels, doubles resolution)&lt;br&gt;• &lt;b&gt;Skip Connections:&lt;/b&gt; Channel-wise concatenation (torch.cat([dec_up, enc_skip], dim=1))&lt;br&gt;• &lt;b&gt;Objective Function:&lt;/b&gt; 1.5 · BCEWithLogitsLoss + 0.5 · SoftDiceLoss (Optimal weight ratio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="190" y="680" width="1150" height="130" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_pipeline" name="2. ML Pipeline &amp; Experimental Setup">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#F8FAFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;Penn-Fudan Pedestrian Segmentation: End-to-End Experimental Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B;&quot;&gt;Phases 1–10: Data Processing, Augmentation, Multi-Stage Ablation Tuning, and Final Test Evaluation&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1. Dataset Ingestion&lt;/b&gt;&lt;br&gt;Penn-Fudan Pedestrian&lt;br&gt;170 images, 345 masks&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Variable H×W (300-500px)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. Preprocessing&lt;/b&gt;&lt;br&gt;• Resize to 256×256&lt;br&gt;• Binarize Multi-Masks&lt;br&gt;• ImageNet Normalization&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Bilinear (img), Nearest (mask)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#3730A3;" vertex="1" parent="1">
          <mxGeometry x="260" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. Stratified Splitting&lt;/b&gt;&lt;br&gt;Fixed Seed 42&lt;br&gt;• Train: 118 images (70%)&lt;br&gt;• Val: 25 images (15%)&lt;br&gt;• Test: 27 images (15%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. Data Augmentation&lt;/b&gt;&lt;br&gt;(Training Only)&lt;br&gt;• Random Horiz Flip (p=0.5)&lt;br&gt;• Random Zoom (0.9-1.1×)&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Identical spatial transforms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE8FF;strokeColor=#C026D3;strokeWidth=2;fontColor=#86198F;" vertex="1" parent="1">
          <mxGeometry x="700" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. Model Training&lt;/b&gt;&lt;br&gt;U-Net (base=32)&lt;br&gt;• Adam Optimizer (lr=0.0005)&lt;br&gt;• Batch Size = 8&lt;br&gt;• Loss = 1.5 BCE + 0.5 Dice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;6. Validation &amp; Tuning&lt;/b&gt;&lt;br&gt;• ReduceLROnPlateau&lt;br&gt;• Early Stopping (patience=10)&lt;br&gt;• Best Model Checkpoint&lt;br&gt;&lt;b&gt;Best Val IoU: 0.7739&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;7. Final Evaluation&lt;/b&gt;&lt;br&gt;Untouched Test Set (27 img)&lt;br&gt;&lt;b&gt;Test IoU: 0.7513&lt;/b&gt;&lt;br&gt;&lt;b&gt;F1-Score: 0.8580&lt;/b&gt;&lt;br&gt;Precision: 0.9023 | Recall: 0.8179" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;" vertex="1" parent="1">
          <mxGeometry x="1360" y="140" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ep1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ep2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" source="p2" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ep3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" source="p3" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ep4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" source="p4" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ep5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" source="p5" target="p6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ep6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" source="p6" target="p7" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="abl_summary" value="&lt;b&gt;Systematic Multi-Phase Experimental Progression &amp; Findings:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Phase 5 (Baseline U-Net):&lt;/b&gt; lr=0.001, BCE 1.0 + Dice 1.0, No Augmentation → &lt;i&gt;Val IoU: 0.7410, F1: 0.8512&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Phase 6 (Data Augmentation):&lt;/b&gt; Added synchronized horizontal flip (p=0.5) &amp; scale zoom (0.9-1.1) → &lt;i&gt;Val IoU: 0.7635 (+2.25%)&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Phase 7 (Learning Rate):&lt;/b&gt; Compared 0.001 vs 0.0005 vs 0.0001; 0.0005 proved optimal → &lt;i&gt;Val IoU: 0.7669 (+0.34%)&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Phase 8 (Loss Weighting):&lt;/b&gt; Evaluated BCE/Dice ratios (1.0/1.0 vs 0.5/1.5 vs 1.5/0.5); 1.5 BCE + 0.5 Dice won → &lt;i&gt;Val IoU: 0.7739 (+0.70%)&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Phase 9 (Capacity Ablation):&lt;/b&gt; Compared base channels 16 (1.94M, IoU 0.7554) vs 32 (7.76M, IoU 0.7739) vs 48 (17.46M, IoU 0.7682)&lt;br&gt;• &lt;b&gt;Phase 10 (Final Test):&lt;/b&gt; Single evaluation on 27 test images → &lt;b&gt;Test IoU: 0.7513, F1: 0.8580, Precision: 0.9023, Recall: 0.8179&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=15;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="300" width="1280" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
